<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:vm="using:FlightTracker.ViewModels"
			 xmlns:model="using:FlightTracker.Models"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
			 x:Class="FlightTracker.Views.View1"
			 x:DataType="vm:View1ViewModel">

	<DockPanel>
		<StackPanel DockPanel.Dock="Top"
					Orientation="Horizontal"
					Spacing="8"
					Margin="12">
			<TextBlock Text="Airport:" VerticalAlignment="Center" />
			<ComboBox Width="320"
					  ItemsSource="{Binding FlightData.Airports}"
					  SelectedItem="{Binding SelectedAirport, Mode=TwoWay}">
				<ComboBox.ItemTemplate>
					<DataTemplate DataType="model:Airport">
						<TextBlock Text="{Binding IataCode}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<Button Content="Clear Selection"
					Command="{Binding ClearSelectionCommand}" />
		</StackPanel>

		<StackPanel DockPanel.Dock="Top" Margin="12,0,12,12">
			<TextBlock Text="{Binding PreferenceStatus}" Foreground="#666666" />
		</StackPanel>

		<Grid Margin="12">
			<mapsui:MapControl x:Name="RouteMapControl" />
		</Grid>
	</DockPanel>

</UserControl>
