<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:FlightTracker.ViewModels"
			 x:DataType="vm:View2ViewModel"
			 x:Class="FlightTracker.Views.View2">

	<StackPanel Orientation="Vertical" Spacing="10" Margin="20">
		<TextBlock Text="View 2 - Flights" FontSize="24" FontWeight="Bold" />
		<TextBlock Text="{Binding LoadStatus}" FontSize="14" />
		<TextBlock Text="{Binding AirportCount, StringFormat='Total Airports: {0}'}" />
		<TextBlock Text="{Binding FlightCount, StringFormat='Total Flights: {0}'}" />
		
		<TextBlock Text="Select Airport:" FontWeight="Bold" Margin="0,10,0,0" />
		<ComboBox ItemsSource="{Binding Airports}"
				  SelectedItem="{Binding SelectedAirport}"
				  Width="300">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Name}" />
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>

		<TextBlock Text="{Binding SelectedAirportInfo}" 
				   Foreground="#0066cc" 
				   Margin="0,10,0,0" />
		
		<TextBlock Text="Flights:" FontWeight="Bold" Margin="0,20,0,0" />
				<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,10">
					<Button Content="Landed" Command="{Binding FilterLandedCommand}" Width="100" />
					<Button Content="Scheduled" Command="{Binding FilterScheduledCommand}" Width="100" />
					<Button Content="Reset" Command="{Binding ResetFiltersCommand}" Width="100" />
					<TextBlock Text="{Binding StatusFilter, StringFormat='Filter: {0}'}" VerticalAlignment="Center" Foreground="#666666" />
				</StackPanel>
		
		
		<ListBox ItemsSource="{Binding DisplayedFlights}" Height="450">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal" Spacing="20">
						<TextBlock Text="{Binding FlightNumber}" Width="80" />
						<TextBlock Text="{Binding ArrivalAirport}" Width="80" />
						<TextBlock Text="{Binding ScheduledDeparture}" Width="150" />
						<TextBlock Text="{Binding AircraftType}" Width="100" />
						<TextBlock Text="{Binding Status}" Width="80" />
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</StackPanel>

</UserControl>
